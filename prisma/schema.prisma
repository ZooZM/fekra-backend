generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here
datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Enums ───────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ClientActivityAction {
  CREATED
  UPDATED
  DELETED
  ACCESS_TOKEN_REPLACED
  REPLY_RUN_STARTED // a reply run on a post's unreplied comments was started
  REPLY_RUN_STOPPED // ...and stopped by an admin before it ended
}

enum Platform {
  FACEBOOK
  INSTAGRAM
}

// How a comment's label was decided (feature 003). UNKNOWN = rows from before it was recorded.
enum CommentDecisionBasis {
  RULES
  AI_MODEL
  SAFE_FALLBACK
  UNKNOWN
}

enum ChatPauseAction {
  PAUSED
  RESUMED
}

enum CommentClassification {
  ENGAGEMENT
  INQUIRY
  UNSURE
  COMPLAINT
  SPAM
  INSULT
}

// ───────────────────────────── Business data ─────────────────────────────

model Client {
  id               String @id @default(uuid()) @db.Uuid
  name             String @db.VarChar(255)
  businessCategory String @map("business_category") @db.VarChar(255)

  // Used to match incoming Meta webhooks to a client, so they must be unique
  fbPageId       String? @unique @map("fb_page_id") @db.VarChar(255)
  instaAccountId String? @unique @map("insta_account_id") @db.VarChar(255)

  // Store ENCRYPTED (e.g. AES-256-GCM) from the service layer. Never save plaintext.
  // Text because the encrypted value (iv + tag + ciphertext) can exceed 255 chars.
  accessToken String @map("access_token") @db.Text

  brandLogo String? @map("brand_logo") @db.VarChar(255)

  // The client's n8n chat workflow: one path segment added to N8N_BASE_URL (validated in NestJS).
  // Several clients may share one workflow (feature 004), so it is not unique. Only a subscribed
  // client's DMs are stored and delivered; subscribing needs an endpoint (also guarded by a CHECK
  // constraint in the migration).
  chatWorkflowEndpoint String? @map("chat_workflow_endpoint") @db.VarChar(100)
  chatSubscribed       Boolean @default(false) @map("chat_subscribed")

  // AI config (validate in NestJS: brandVoice max 400 chars,
  // language one of ENGLISH | ARABIC | ENGLISH_ARABIC)
  // { "brandVoice": "Friendly and casual", "language": "ARABIC" }
  aiConfig Json @default("{\"language\": \"ARABIC\"}") @map("ai_config")

  // Auto-reply configuration (validate the shape in NestJS with Zod / class-validator)
  // Example:
  // {
  //   "enabled": true,
  //   "default_reply": "Thanks for reaching out!",
  //   "rules": [{ "keywords": ["price"], "reply": "Our prices start at..." }]
  // }
  dmReplyConfig      Json @default("{}") @map("dm_reply_config")
  commentReplyConfig Json @default("{}") @map("comment_reply_config")

  // Optimistic concurrency: edits must send the version they started from.
  // +1 on every edit that changes something. Token replacement does not change it.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  businessInfo   BusinessInfo?
  services       Service[]
  offers         Offer[]
  users          User[]
  chats          Chat[]
  commentReplies CommentReply[]
  leads          Lead[]

  @@index([chatWorkflowEndpoint])
  @@map("clients")
}

model BusinessInfo {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @unique @map("client_id") @db.Uuid

  // Contact split into real columns (fixed shape, read constantly by the bot)
  phone    String? @db.VarChar(50)
  email    String? @db.VarChar(255)
  whatsapp String? @db.VarChar(50)
  website  String? @db.VarChar(255)

  // Free-form list, any platform (no fixed keys):
  // [{ "platform": "instagram", "url": "https://..." }, ...]
  socialMedia Json @default("[]") @map("social_media")

  // {
  //   "city": "...", "district": "...", "full_address": "...",
  //   "links": [{ "url": "https://maps...", "description": "..." }]
  // }
  location Json?

  // { "startTime": "09:00", "endTime": "17:00", "days": ["sunday", "monday"] }
  // (or an array of these if hours differ between days)
  workHours Json? @map("work_hours")

  // Free-form (no enums), e.g. ["cash", "card", "instapay"]
  paymentMethods     String[] @default([]) @map("payment_methods")
  // Free-form, e.g. ["valU", "Sympl"]
  installmentOptions String[] @default([]) @map("installment_options")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("business_info")
}

model Service {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  // One offer can cover many services; a service has at most one offer.
  // Optional: most services have no offer. Deleting an offer just un-links its services.
  // App-level rule: offer.clientId must equal service.clientId.
  offerId String? @map("offer_id") @db.Uuid

  name        String  @db.VarChar(255)
  description String? @db.VarChar(255)
  price       String? @db.VarChar(255)

  // Shape varies per service, e.g. [{ "name": "Large", "price": "150" }]
  // Variant names should be unique per service (validate in NestJS).
  variants Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer  Offer? @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([offerId])
  @@map("services")
}

model Offer {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @map("client_id") @db.Uuid

  title         String       @db.VarChar(255)
  description   String?      @db.VarChar(255)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)
  startDate     DateTime     @map("start_date") @db.Date
  endDate       DateTime     @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([clientId])
  @@index([startDate, endDate])
  @@map("offers")
}

// ───────────────────────────── Auth ─────────────────────────────

model User {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(255)

  // Lowercase + trim in the app before saving (Prisma can't enforce this).
  email String @unique @db.VarChar(255)

  // Prisma has no `select: false`. Hide these with Prisma's `omit` option
  // (e.g. global omit in the PrismaClient constructor) so they never leak into responses.
  passwordHash        String    @map("password_hash")
  passwordChangedAt   DateTime? @map("password_changed_at")
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")

  roles UserRole[] @default([CLIENT])

  // Which business a CLIENT-role user belongs to (null for admins)
  clientId String? @map("client_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([clientId])
  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // Store a HASH of the token (e.g. SHA-256), never the raw token
  tokenHash  String    @unique @map("token_hash")
  // Absolute limit: sign-in time + 12 h. The model is a sign-in session (name kept to avoid churn).
  expiresAt  DateTime  @map("expires_at")
  // Idle limit: refresh is refused when now - lastUsedAt >= 30 min
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ───────────────────────────── Activity record ─────────────────────────────

// Who changed which client, and when. Written in the same transaction as the change.
// No relations on purpose: entries must outlive the client and the admin account, so the
// names are copied in. Never store token values here. Entries are never updated or deleted.
model ClientActivity {
  id            String               @id @default(uuid()) @db.Uuid
  clientId      String               @map("client_id") @db.Uuid
  clientName    String               @map("client_name") @db.VarChar(255)
  actorId       String               @map("actor_id") @db.Uuid
  actorName     String               @map("actor_name") @db.VarChar(255)
  actorEmail    String               @map("actor_email") @db.VarChar(255)
  action        ClientActivityAction
  // UPDATED only: top-level field names that changed, never values
  changedFields String[]             @default([]) @map("changed_fields")
  // REPLY_RUN_* only: { runId, platform, accountId, postId, toAnswer, handled? } (ids and counts,
  // never a token or comment text). Validated by ReplyRunActivityDetailsSchema, read through
  // readReplyRunDetails. Null for the other actions.
  details       Json?                @map("details")
  createdAt     DateTime             @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("client_activities")
}

// ───────────────────────────── Chats ─────────────────────────────
// One conversation between a customer and one of the client's accounts.
// The `id` is the chat_id that message_replies point to.
// These tables hold customers' messages: RETENTION_MONTHS (default 12) decides how long they stay,
// and a daily run deletes the older rows.
model Chat {
  id       String   @id @default(uuid()) @db.Uuid
  clientId String   @map("client_id") @db.Uuid
  platform Platform

  // The customer: Messenger PSID or Instagram IGSID
  senderId   String @map("sender_id") @db.VarChar(255)
  // The client's account that received the message: matches Client.fbPageId or Client.instaAccountId
  receiverId String @map("receiver_id") @db.VarChar(255)

  // Assistant pause. Paused now = pausedAt set AND (pausedUntil null OR pausedUntil > now): the
  // state is computed, never trusted from a flag. pausedUntil null = until resumed.
  pausedAt     DateTime? @map("paused_at")
  pausedUntil  DateTime? @map("paused_until")
  // Copied from the admin (no foreign key), so they outlive the user
  pausedById   String?   @map("paused_by_id") @db.Uuid
  pausedByName String?   @map("paused_by_name") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  messages    MessageReply[]
  pauseEvents ChatPauseEvent[]

  // One chat per customer per account, so find-or-create is a single upsert
  @@unique([platform, receiverId, senderId])
  @@index([clientId])
  @@index([updatedAt])
  @@index([pausedUntil])
  @@map("chats")
}

// A customer message and the reply that was sent to it. Append-only.
// The DM pipeline batches messages sent within a few seconds of each other, so `message`
// holds the whole batch (join the pieces with a line break).
model MessageReply {
  id     String @id @default(uuid()) @db.Uuid
  chatId String @map("chat_id") @db.Uuid

  message  String  @db.Text
  // Empty when answered = false
  reply    String  @db.Text
  // false = the assistant did not answer (the conversation was paused)
  answered Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  // Loading a chat's history in order
  @@index([chatId, createdAt])
  // Retention deletes by age
  @@index([createdAt])
  @@map("message_replies")
}

// Every pause and resume of a conversation. Append-only (so no updatedAt), like ClientActivity.
// actorId null on RESUMED = the timed pause ended by itself.
model ChatPauseEvent {
  id        String          @id @default(uuid()) @db.Uuid
  chatId    String          @map("chat_id") @db.Uuid
  action    ChatPauseAction
  // PAUSED only: until_resumed | 1h | 24h | 7d
  duration  String?         @db.VarChar(16)
  // PAUSED only: the end time, null = until resumed
  until     DateTime?
  actorId   String?         @map("actor_id") @db.Uuid
  actorName String?         @map("actor_name") @db.VarChar(255)
  createdAt DateTime        @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("chat_pause_events")
}

// ───────────────────────────── Comments ─────────────────────────────

// Every comment that was classified, with the label and why. Useful for auditing the
// classifier and as labeled training data later. Holds customer text: same retention note as Chat.
model CommentReply {
  id       String   @id @default(uuid()) @db.Uuid
  clientId String   @map("client_id") @db.Uuid
  platform Platform

  // Meta's id for the comment, so a redelivered or re-classified comment updates one row
  commentId String @map("comment_id") @db.VarChar(255)

  // The comment text (Facebook allows up to 8000 characters)
  comment        String                @db.Text
  classification CommentClassification
  // e.g. `keyword "how"`, `question mark`, or the LLM's explanation
  reason         String                @db.Text
  // How the label was decided, so the model can be judged later (feature 003)
  decisionBasis  CommentDecisionBasis  @default(UNKNOWN) @map("decision_basis")
  // The model that gave the label (AI_MODEL only)
  decisionModel  String?               @map("decision_model") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([platform, commentId])
  @@index([clientId, createdAt])
  // All-clients list, export keyset and retention
  @@index([createdAt, id])
  @@map("comment_replies")
}

// One row per comments download: who, when, which filters, how many rows, did it finish.
// The filters hold no comment text. Written when the download starts (completed = false) and
// updated when it ends. No relations on purpose: it outlives the admin account.
model CommentExportRecord {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorName  String   @map("actor_name") @db.VarChar(255)
  actorEmail String   @map("actor_email") @db.VarChar(255)
  // ExportFiltersSchema, read through readExportFilters
  filters    Json
  rowCount   Int?     @map("row_count")
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([actorId])
  @@index([createdAt])
  @@map("comment_export_records")
}

// ───────────────────────────── Leads ─────────────────────────────

// What a chat workflow has learned about one customer on one client account (feature 004). Generic:
// it serves every client, and per-business data goes in `fields`. Only n8n reads and writes it,
// through /n8n/leads. Holds personal data (phone numbers): the retention run deletes leads not
// updated for RETENTION_MONTHS.
model Lead {
  id         String    @id @default(uuid()) @db.Uuid
  clientId   String    @map("client_id") @db.Uuid
  platform   Platform
  // Page ID / IG account ID: always the client's own (checked on every request)
  accountId  String    @map("account_id") @db.VarChar(255)
  // PSID / IGSID
  senderId   String    @map("sender_id") @db.VarChar(255)
  // Free text: stages differ per client
  stage      String    @default("new") @db.VarChar(50)
  phone      String?   @db.VarChar(30)
  country    String?   @db.VarChar(2)
  lastIntent String?   @map("last_intent") @db.VarChar(50)
  summary    String?   @db.Text
  // Flat object of string values. LeadFieldsSchema, read through readLeadFields
  fields     Json      @default("{}")
  // Set once, by a conditional update: the request that set it notifies the client
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([platform, accountId, senderId])
  @@index([clientId, stage, updatedAt])
  @@index([updatedAt])
  @@map("leads")
}
