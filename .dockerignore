# Docker build context. Keep it small, and keep secrets out of every image layer
# (constitution IV: no .env files or real tokens in images).

# Secrets and local configuration
.env
.env.*

# Dependencies and build output: rebuilt inside the image
node_modules
dist
src/generated
coverage
*.tsbuildinfo

# Not needed to build or run the API
.git
.github
.claude
.agents
.specify
.postman
.vscode
.idea
postman
postman-export
specs
openapi
test
scripts
deploy
compose.yml
Dockerfile
.dockerignore
*.md
skills-lock.json
*.log
