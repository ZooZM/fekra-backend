{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "target": "ES2023",
          "experimentalDecorators": true,
          "emitDecoratorMetadata": true,
          "esModuleInterop": true
        },
        "isolatedModules": true,
        "diagnostics": false
      }
    ]
  },
  "transformIgnorePatterns": [
    "[\\\\/]node_modules[\\\\/](?!(@nestjs[\\\\/](config|jwt|passport))[\\\\/])"
  ],
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/../src/$1",
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@config/(.*)$": "<rootDir>/../src/config/$1"
  },
  "globalSetup": "<rootDir>/utils/e2e-global-setup.ts",
  "setupFiles": [
    "<rootDir>/utils/e2e-env.ts"
  ],
  "maxWorkers": 1,
  "testTimeout": 30000
}
