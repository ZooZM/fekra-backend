# Copy to .env.development.local (never commit real values).

NODE_ENV=development
PORT=3000

# --- Crypto ---
# 64 hex characters (32 bytes): openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fekra

# --- Auth ---
JWT_SECRET=change-me
# Access token lifetime. Production uses 10m (the session cookie keeps the admin signed in).
JWT_EXPIRES_IN=10m
# Sign-in session limits (spec FR-003)
# 0 removes a limit: SESSION_IDLE_MINUTES=0 and SESSION_MAX_HOURS=0 keep an admin signed in
# until they sign out (the 10-minute access token is renewed silently from the session cookie).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Path of the session cookie. Behind the production proxy this is /api/auth.
SESSION_COOKIE_PATH=/auth
# Origin of the dashboard; /auth/refresh and /auth/logout only accept requests from it
APP_ORIGIN=http://localhost:5173
# Extra allowed browser origins, comma-separated. Leave empty when the dashboard is same-origin.
CORS_ORIGINS=
# Sign-in throttling per email (spec FR-027)
LOGIN_MAX_FAILURES=5
LOGIN_BLOCK_MINUTES=15

# --- API contract ---
# Serves /docs-json outside production
OPENAPI_ENABLED=true

# --- Meta (Facebook / Instagram) ---
META_VERIFY_TOKEN=change-me
META_APP_SECRET=change-me
INSTAGRAM_APP_SECRET=change-me
META_PAGE_ID=
META_IG_USER_ID=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
DISPATCH_INTERVAL_MS=
DISPATCH_BATCH=
DISPATCH_COMMENT_RESERVED=
RATE_LIMIT_COMMENTS_PER_MIN=
RATE_LIMIT_MESSAGES_PER_MIN=
# Reply runs on a post's unreplied comments (POST /inbox/comments/backfill)
# Pause between two comments, in ms, to stay under Meta's spam limits
COMMENT_BACKFILL_DELAY_MS=5000
# Comments checked per post, for unreplied counts and runs
COMMENT_BACKFILL_MAX=500
# Seconds an ended run stays visible on its post (24 h)
COMMENT_BACKFILL_RESULT_TTL_SEC=86400
DM_WINDOW_SEC=
# How often expired conversation pauses are recorded, in ms
PAUSE_SWEEP_INTERVAL_MS=30000
# Rows read per database round trip while exporting comments to CSV
COMMENT_EXPORT_BATCH=1000
# Customer messages and classified comments older than this many months are deleted daily (min 1)
RETENTION_MONTHS=12
N8N_ACK_TTL_SEC=
N8N_MAX_ATTEMPTS=3

# --- n8n ---
# Fixed base address of the n8n chat workflows. Each client's endpoint is appended to it
# (required in production). Replaces N8N_WEBHOOK_URL.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=change-me

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_COMMENT_MODEL=
GEMINI_COMMENT_FALLBACK_MODEL=
GEMINI_COMMENT_THINKING_LEVEL=
GEMINI_COMMENT_TIMEOUT_MS=8000
